"use client";

import { useState, useEffect } from "react";
import { useAuth } from "../../../hooks/useAuth";
import { useRouter } from "next/navigation";

export default function EditProfilePage() {
  const { user, token } = useAuth();
  const router = useRouter();
  const [phone, setPhone] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [message, setMessage] = useState("");
  const [errors, setErrors] = useState<{ phone?: string; password?: string }>({});

  useEffect(() => {
    if (user?.phone) {
      setPhone(user.phone);
    }
  }, [user]);

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();

    // 🔹 Validaciones frontend
    const newErrors: { phone?: string; password?: string } = {};
    if (phone && !/^\d{8,}$/.test(phone)) {
      newErrors.phone = "El teléfono debe tener al menos 8 dígitos numéricos.";
    }
    if (password && password.length < 6) {
      newErrors.password = "La contraseña debe tener al menos 6 caracteres.";
    }
    setErrors(newErrors);

    if (Object.keys(newErrors).length > 0) return;

    try {
      const res = await fetch(`${process.env.NEXT_PUBLIC_API_URL}/profile`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          phone,
          ...(password ? { password } : {}),
        }),
      });

      if (res.ok) {
        setMessage("Perfil actualizado correctamente ✅");
        setTimeout(() => router.push("/profile"), 1500);
      } else {
        const err = await res.json();
        setMessage(err.errors || "Error al actualizar perfil ❌");
      }
    } catch (error) {
      console.error(error);
      setMessage("Error de conexión ❌");
    }
  }

  if (!user) return <p className="text-center py-10">No hay sesión activa</p>;

  return (
    <div className="max-w-md mx-auto mt-10 bg-white rounded-lg shadow-md p-6">
      <h1 className="text-2xl font-bold mb-4 text-blue-600">Editar perfil</h1>

      <form onSubmit={handleSubmit} className="space-y-4">
        {/* Teléfono */}
        <div>
            <label className="block font-semibold mb-1">Teléfono actual</label>
            <input
                type="tel"
                inputMode="numeric" // fuerza teclado numérico en móviles
                value={phone}
                onChange={(e) => setPhone(e.target.value.replace(/\D/g, ""))}
                className="w-full border p-2 rounded"
                placeholder="No registrado"
            />
            {errors.phone && <p className="text-red-600 text-sm mt-1">{errors.phone}</p>}
        </div>


        {/* Contraseña con toggle */}
        <div>
          <label className="block font-semibold mb-1">Nueva contraseña</label>
          <div className="flex items-center border rounded">
            <input
              type={showPassword ? "text" : "password"}
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              className="flex-1 p-2 rounded-l"
              placeholder="Escribe nueva contraseña"
            />
            <button
              type="button"
              onClick={() => setShowPassword(!showPassword)}
              className="px-3 text-sm bg-gray-200 hover:bg-gray-300 rounded-r"
            >
              {showPassword ? "🙈 Ocultar" : "👁️ Mostrar"}
            </button>
          </div>
          <p className="text-xs text-gray-500 mt-1">
            Por seguridad no mostramos tu contraseña actual. Si quieres cambiarla, escribe una nueva aquí.
          </p>
          {errors.password && <p className="text-red-600 text-sm mt-1">{errors.password}</p>}
        </div>

        <button
          type="submit"
          className="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md"
        >
          Guardar cambios
        </button>
      </form>

      {message && <p className="mt-4 text-center">{message}</p>}
    </div>
  );
}
